{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipDrop",
  "version": "0.3.0",
  "identifier": "local.nit.clipdrop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-ui.cjs",
    "beforeBuildCommand": "node scripts/prepare-ui.cjs",
    "frontendDist": "../.build/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipDrop",
        "width": 560,
        "height": 300,
        "minWidth": 520,
        "minHeight": 280,
        "create": false,
        "backgroundColor": "#202624",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Descargador personal de videos",
    "copyright": "Copyright © 2026 Nicolás Tovillas",
    "icon": [
      "../assets/icon.png",
      "../assets/icon.ico",
      "../assets/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "Nicolás Tovillas"
  }
}
